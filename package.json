{
  "name": "kkrdr",
  "private": true,
  "version": "1.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --project demo-kkrdr --only firestore,auth",
    "seed": "node scripts/seed-emulator.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --project demo-kkrdr --only firestore \"vitest run rules-test\"",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "blobatar": "^2.7.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
