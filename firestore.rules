rules_version = '2';

// Access model: every device signs in anonymously, then links itself to a user
// by writing sessions/{uid} with a secret key handed out by an admin.
// A device is "valid" while its key still exists, still points to the same user,
// and that user is active. Deleting a key cuts off every device using it.
service cloud.firestore {
  match /databases/{database}/documents {

    function sess() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
    }

    function valid() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/keys/$(sess().key)).data.userId == sess().userId
        && get(/databases/$(database)/documents/users/$(sess().userId)).data.active == true;
    }

    function isAdmin() {
      return valid()
        && get(/databases/$(database)/documents/users/$(sess().userId)).data.admin == true;
    }

    // One-time setup (npm run create-admin): until config/setup exists, anyone signed in
    // may create the first admin, in the same batch that creates config/setup.
    function bootstrapping() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/config/setup)
        && existsAfter(/databases/$(database)/documents/config/setup);
    }

    match /config/setup {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.admin == true
        && getAfter(/databases/$(database)/documents/keys/$(request.resource.data.key)).data.userId
           == request.resource.data.userId;
    }

    match /keys/{key} {
      // Knowing the key is the secret, so fetching a single key is fine.
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
      allow create: if bootstrapping()
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.userId));
    }

    match /sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key', 'userId', 'createdAt'])
        && request.resource.data.key is string
        && exists(/databases/$(database)/documents/keys/$(request.resource.data.key))
        && get(/databases/$(database)/documents/keys/$(request.resource.data.key)).data.userId
           == request.resource.data.userId;
    }

    function validUser(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.admin is bool && d.active is bool;
    }

    match /users/{userId} {
      allow read: if valid();
      allow create: if bootstrapping() && validUser(request.resource.data) && request.resource.data.admin == true;
      allow write: if isAdmin() && (request.resource == null || validUser(request.resource.data));
    }

    function optString(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    function optIntRange(d, field, lo, hi) {
      return !(field in d) || (d[field] is int && d[field] >= lo && d[field] <= hi);
    }

    function validPoop(d) {
      return d.keys().hasAll(['userId', 'at', 'type', 'size', 'place', 'createdAt'])
        && d.keys().hasOnly(['userId', 'at', 'type', 'size', 'place', 'placeNote',
                             'duration', 'rating', 'color', 'note', 'createdAt', 'votes', 'perfect', 'commentCount',
                             'photo', 'gif', 'sound'])
        && d.at is timestamp
        // Generous margin: a phone clock or time zone set wrong must not block logging (the app checks too).
        && d.at <= request.time + duration.value(1, 'd')
        && d.type is int && d.type >= 1 && d.type <= 7
        && d.size in ['S', 'M', 'L', 'XL']
        && d.place in ['home', 'work', 'friends', 'public', 'other']
        && optString(d, 'placeNote', 60)
        && optString(d, 'note', 280)
        && optIntRange(d, 'duration', 0, 180)
        && optIntRange(d, 'rating', 1, 5)
        && (!('color' in d) || d.color in ['brown', 'dark', 'light', 'yellow', 'green', 'red', 'black', 'grey'])
        // A Perfect is always smooth (type 4) rated 5.
        && (!('perfect' in d) || (d.perfect == true && d.type == 4 && d.rating == 5))
        // A photo (its version; the image is in pictures/) or a GIF from Tenor or GIPHY, not both.
        // Same pattern as STORED in src/gifs.ts.
        && (!('photo' in d) || d.photo is int)
        && (!('gif' in d) || (d.gif is string && d.gif.size() <= 500
            && d.gif.matches('https://((media[0-9]*|c)[.]tenor[.]com|(media[0-9]*|i)[.]giphy[.]com)/[^ ]+|https://tenor[.]com/[^ ]+[.]gif')))
        && !('photo' in d && 'gif' in d)
        // A recording: its version (the audio is in sounds/) and length, up to 30 seconds.
        && (!('sound' in d) || (d.sound is map && d.sound.keys().hasOnly(['v', 'secs'])
            && d.sound.v is int && d.sound.secs is int && d.sound.secs >= 1 && d.sound.secs <= 30));
    }

    // votes is a map { userId: 1 | -1 }; a vote may only add, change or remove your own entry.
    function validVote(before, after, me) {
      return after.diff(before).affectedKeys().hasOnly([me])
        && (!(me in after) || after[me] in [1, -1]);
    }

    // likes is a list of user ids; a like may only add or remove yours, once.
    function validLike(before, after, me) {
      return after is list && (
        (!(me in before) && after.size() == before.size() + 1 && after.toSet() == before.toSet().union([me].toSet()))
        || (me in before && after.size() == before.size() - 1 && after.toSet() == before.toSet().difference([me].toSet())));
    }

    // An entry's photo, written by its owner in the same batch as the entry, whose photo field
    // names this version. It goes with the entry.
    match /pictures/{poopId} {
      function entry() {
        return /databases/$(database)/documents/poops/$(poopId);
      }
      allow read: if valid();
      allow create, update: if valid()
        && getAfter(entry()).data.userId == sess().userId
        && request.resource.data.keys().hasOnly(['img', 'type', 'v'])
        && request.resource.data.img is bytes
        && request.resource.data.img.size() <= 260000
        && request.resource.data.type in ['image/webp', 'image/jpeg']
        && request.resource.data.v == getAfter(entry()).data.get('photo', null);
      allow delete: if isAdmin() || (valid() && get(entry()).data.userId == sess().userId);
    }

    // An entry's sound recording: same as its photo. Audio as recorded by the browser
    // (Opus in WebM / Ogg, or AAC in MP4 on Apple devices).
    match /sounds/{poopId} {
      function soundEntry() {
        return /databases/$(database)/documents/poops/$(poopId);
      }
      allow read: if valid();
      allow create, update: if valid()
        && getAfter(soundEntry()).data.userId == sess().userId
        && request.resource.data.keys().hasOnly(['audio', 'type', 'v'])
        && request.resource.data.audio is bytes
        && request.resource.data.audio.size() <= 500000
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 60
        && request.resource.data.type.matches('audio/(webm|ogg|mp4|mpeg|aac)(;.*)?')
        && request.resource.data.v == getAfter(soundEntry()).data.get('sound', {}).get('v', null);
      allow delete: if isAdmin() || (valid() && get(soundEntry()).data.userId == sess().userId);
    }

    // Profile pictures: a small image per user, written only by its owner.
    match /avatars/{userId} {
      allow read: if valid();
      allow create, update: if valid() && sess().userId == userId
        && request.resource.data.keys().hasOnly(['img', 'type', 'updatedAt'])
        && request.resource.data.img is bytes
        && request.resource.data.img.size() <= 60000
        && request.resource.data.type in ['image/webp', 'image/jpeg']
        && request.resource.data.updatedAt == request.time;
      allow delete: if (valid() && sess().userId == userId) || isAdmin();
    }

    // Title shop: the titles a user bought with poop points, and the one they wear. Earned points
    // come from the reports, which rules can't add up: the app checks the buyer can afford it.
    match /titles/{userId} {
      // Kept in step with TITLES in src/shop.ts (src/shop.test.ts checks).
      function prices() {
        return { 'rookie': 5, 'buddy': 8, 'regular': 15, 'flusher': 20, 'knight': 30, 'scholar': 35, 'master': 50, 'lord': 50 };
      }
      function before() {
        return resource == null ? { 'owned': {}, 'spent': 0 } : resource.data;
      }
      function bought(d) {
        return d.last is string && d.last in prices()
          && !(d.last in before().owned)
          && d.owned.diff(before().owned).affectedKeys() == [d.last].toSet()
          && d.owned[d.last] == true
          && d.spent == before().spent + prices()[d.last];
      }
      allow read: if valid();
      allow create, update: if valid() && sess().userId == userId
        && request.resource.data.keys().hasOnly(['owned', 'spent', 'last', 'worn'])
        && request.resource.data.owned is map
        && request.resource.data.spent is int
        && (!('worn' in request.resource.data) || request.resource.data.worn in request.resource.data.owned)
        && (bought(request.resource.data)
            // Wearing a title or taking it off.
            || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['worn'])));
      allow delete: if isAdmin();
    }

    // Week / month reports. No server: the first client after a period ends writes it once,
    // then it never changes (an admin may delete a bad one, the next client writes it again).
    match /reports/{id} {
      allow read: if valid();
      allow create: if valid()
        && id.matches('(week-[0-9]{4}-[0-9]{2}-[0-9]{2}|month-[0-9]{4}-[0-9]{2})')
        && request.resource.data.keys().hasOnly(['kind', 'start', 'end', 'count', 'winners', 'createdBy', 'createdAt'])
        && request.resource.data.kind in ['week', 'month']
        && id.matches(request.resource.data.kind + '-.*')
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp
        && request.resource.data.start < request.resource.data.end
        // Only a period that is over.
        && request.resource.data.end <= request.time
        && request.resource.data.count is int
        && request.resource.data.winners is map
        && request.resource.data.createdBy == sess().userId
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    match /poops/{poopId} {
      allow read: if valid();
      allow create: if valid()
        && request.resource.data.userId == sess().userId
        && request.resource.data.createdAt == request.time
        && !('votes' in request.resource.data)
        && !('commentCount' in request.resource.data)
        && validPoop(request.resource.data);
      // Owner edits: anything but the votes and the comment count.
      allow update: if valid()
        && resource.data.userId == sess().userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('votes', {}) == resource.data.get('votes', {})
        && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0)
        && validPoop(request.resource.data);
      // Voting on someone else's poop.
      allow update: if valid()
        && resource.data.userId != sess().userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes is map
        && validVote(resource.data.get('votes', {}), request.resource.data.votes, sess().userId);
      allow delete: if (valid() && resource.data.userId == sess().userId) || isAdmin();
      // The comment count, by anyone: up by one, or down (several at once when an admin removes a user).
      // Rules can't tie it to a given comment; the comment rules below require the matching change.
      allow update: if valid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount < resource.data.get('commentCount', 0));

      function poopPath() {
        return /databases/$(database)/documents/poops/$(poopId);
      }

      function countBefore() {
        return get(poopPath()).data.get('commentCount', 0);
      }

      function countAfter() {
        return getAfter(poopPath()).data.get('commentCount', 0);
      }

      function validText(d) {
        return d.text is string && d.text.size() <= 280
          // Empty only on a voice comment.
          && (d.text.size() > 0 || 'sound' in d)
          // Who the text tags (user ids), so they can be notified.
          && (!('mentions' in d) || (d.mentions is list && d.mentions.size() > 0 && d.mentions.size() <= 10))
          // A voice message: its version (the audio is in commentSounds/) and length, up to 15 seconds.
          && (!('sound' in d) || (d.sound is map && d.sound.keys().hasOnly(['v', 'secs'])
              && d.sound.v is int && d.sound.secs is int && d.sound.secs >= 1 && d.sound.secs <= 15));
      }

      // Comments, written in the same batch as the entry's commentCount.
      match /comments/{commentId} {
        allow read: if valid();
        allow create: if valid()
          && request.resource.data.keys().hasOnly(['userId', 'text', 'createdAt', 'mentions', 'sound'])
          && request.resource.data.userId == sess().userId
          && validText(request.resource.data)
          // A voice message comes with its audio.
          && (!('sound' in request.resource.data)
              || existsAfter(/databases/$(database)/documents/poops/$(poopId)/commentSounds/$(commentId)))
          && request.resource.data.createdAt == request.time
          && countAfter() == countBefore() + 1;
        // The author may change the text (and so who it tags), not the voice message.
        allow update: if valid()
          && resource.data.userId == sess().userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentions'])
          && validText(request.resource.data)
          && request.resource.data.editedAt == request.time;
        // Anyone but the author may like it, or take their like back.
        allow update: if valid()
          && resource.data.userId != sess().userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && validLike(resource.data.get('likes', []), request.resource.data.likes, sess().userId);
        // An admin may always delete (removing a user clears threads in chunks); the app still
        // lowers the count when a single comment goes.
        allow delete: if isAdmin() || (valid() && (
          // With the entry, in the same batch: by the author or the entry's owner.
          (!existsAfter(poopPath())
            && (resource.data.userId == sess().userId || get(poopPath()).data.userId == sess().userId))
          // On its own: by the author, the count going down.
          || (resource.data.userId == sess().userId && countAfter() < countBefore())));
      }
    }

    // A voice comment's audio, written with the comment (whose sound field names this version)
    // and never changed after. It goes with the comment, or with the entry.
    match /poops/{poopId}/commentSounds/{commentId} {
      function commentPath() {
        return /databases/$(database)/documents/poops/$(poopId)/comments/$(commentId);
      }
      allow read: if valid();
      allow create: if valid()
        && getAfter(commentPath()).data.userId == sess().userId
        && request.resource.data.keys().hasOnly(['audio', 'type', 'v'])
        && request.resource.data.audio is bytes
        && request.resource.data.audio.size() <= 250000
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 60
        && request.resource.data.type.matches('audio/(webm|ogg|mp4|mpeg|aac)(;.*)?')
        && request.resource.data.v == getAfter(commentPath()).data.get('sound', {}).get('v', null);
      allow delete: if isAdmin() || (valid() && !existsAfter(commentPath())
        && (get(commentPath()).data.userId == sess().userId
            || get(/databases/$(database)/documents/poops/$(poopId)).data.userId == sess().userId));
    }

    // Across entries: the comments tagging you (notifications), and an admin removing a user
    // finds their comments. Every comment is already readable on its entry.
    match /{path=**}/comments/{commentId} {
      allow read: if valid();
    }
  }
}
